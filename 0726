            <span class="stay-info">🏠 宿：Villa Hana Saku Karuizawa Miyota - HOSHI</span>
        </div>
        <div class="image-gallery">
            <img src="https://images.unsplash.com/photo-1448375240586-882707db888b?q=80&w=600&auto=format&fit=crop" class="main-img" alt="" onerror="this.src='https://placehold.co/600x400/e2e8f0/475569?text=Forest+Shrine';">
